{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sop-forge-production.up.railway.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://sop-forge-production.up.railway.app/health"
    },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
