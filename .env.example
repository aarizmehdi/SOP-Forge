# ════════════════════════════════════════════════
# SOP FORGE — BACKEND ENVIRONMENT VARIABLES
# ════════════════════════════════════════════════
# These variables should be added to your Render.com 
# Environment Variables section during deployment.

# ── 1. Required AI Key ──
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── 2. Security ──
# Generate a strong random string for production
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# ── 3. Database (Optional for Render) ──
# Render handles database setup. If you leave these blank,
# SOP Forge will automatically use a local SQLite file (sopforge.db).
# If you attach a Render PostgreSQL database, paste the URL here:
# DATABASE_URL=postgresql+asyncpg://...
# DATABASE_URL_SYNC=postgresql://...

# ── 4. Redis (Optional for Render) ──
# If blank, SOP Forge will use an In-Memory store automatically.
# REDIS_URL=redis://...

# ── 5. App Settings (Optional) ──
CONFIDENCE_THRESHOLD=0.85
SLA_DEFAULT_HOURS=2
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

